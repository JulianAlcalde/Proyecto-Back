{
  "info": {
    "name": "TPI Servicios Domiciliarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "gateway", "value": "http://localhost:8080"},
    {"key": "token", "value": ""},
    {"key": "workOrderId", "value": "1"}
  ],
  "item": [
    {
      "name": "Crear técnico (despachador)",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": "{{gateway}}/api/technicians",
        "body": {"mode": "raw", "raw": "{\n  \"fullName\": \"María Gómez\",\n  \"keycloakUserId\": \"44444444-4444-4444-4444-444444444444\",\n  \"skills\": [\"PLOMERIA\"],\n  \"certificationValidUntil\": \"2027-12-31\",\n  \"latitude\": -31.4201,\n  \"longitude\": -64.1888\n}"}
      }
    },
    {
      "name": "Crear orden (cliente)",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": "{{gateway}}/api/work-orders",
        "body": {"mode": "raw", "raw": "{\n  \"serviceType\": \"PLOMERIA\",\n  \"description\": \"Pérdida de agua debajo de la mesada\",\n  \"address\": \"Nueva Córdoba, Córdoba\",\n  \"latitude\": -31.4286,\n  \"longitude\": -64.1842,\n  \"requestedStart\": \"2027-06-20T10:00:00\",\n  \"durationMinutes\": 60\n}"}
      }
    },
    {
      "name": "Iniciar orden (técnico)",
      "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{gateway}}/api/work-orders/{{workOrderId}}/start"}
    },
    {
      "name": "Finalizar orden (técnico)",
      "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{gateway}}/api/work-orders/{{workOrderId}}/complete"}
    },
    {
      "name": "Reintentar asignación (despachador)",
      "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{gateway}}/api/work-orders/{{workOrderId}}/assign"}
    }
  ]
}
